{
  "_comment": "Northern Ireland \u2014 the NI Online Tariff applies the EU's TARIC baseline under the Windsor Framework, so this jurisdiction reuses the eu_taric adapter and the same CIRCABC monthly release; only the identity, artifact paths, and coverage narrative differ. 'At risk' goods pay these EU-aligned duties; 'not at risk' (UKIMS) goods pay the UK (GB) rate.",
  "code": "XI",
  "name": "Northern Ireland",
  "tariff_schedule_name": "Northern Ireland Online Tariff",
  "lang": "en",
  "acquire": {
    "adapter": "eu_taric",
    "options": {
      "dest": "data/xi_tariff_source/xi_tariff_{year}_rev_{number}.csv"
    },
    "manual_dir": "data/xi_tariff_source",
    "manual_prefix": "xi_tariff"
  },
  "source_format": "taric",
  "chapters_file": "scripts/hts_automation/chapters_xi.json",
  "max_depth": 10,
  "revision_id_pattern": "{year}_rev_{number}",
  "namespace_pattern": "xi__{year}_rev_{number}",
  "stem_pattern": "xi_{year}_rev_{number}",
  "registry": "config/jurisdictions/xi_revisions.csv",
  "steps": [
    "acquire",
    "build",
    "verify",
    "publish",
    "register",
    "ship"
  ],
  "verify": {
    "max_removed_pct": 2.0,
    "max_added_pct": 5.0,
    "max_leaf_to_internal_pct": 0.5,
    "max_redescribed_pct": 15.0
  },
  "publish": {
    "keep": 3,
    "golden_queries": "config/jurisdictions/xi_golden_queries.json"
  },
  "register": {
    "ragie_partition_id_template": "xi_taric_{year}",
    "promote_country_pointer": true
  },
  "ship": {
    "owner": "SAIL-Engineering",
    "repo": "sail-gtx-prerelease",
    "also": [
      {
        "from": "codes_json",
        "to": "server/data/hts/xi_{year}_rev_{number}.codes.json"
      },
      {
        "from": "explorer_json",
        "to": "server/data/hts/xi_{year}_revision_{number}.json"
      },
      {
        "from": "rates_dir",
        "to": "server/data/duty-rates/{jur_lower}_{revision}.rates"
      },
      {
        "from": "rates_index",
        "to": "server/data/duty-rates/{jur_lower}_{revision}.rates.index.json"
      },
      {
        "from": "treatments_json",
        "to": "server/data/duty-rates/{jur_lower}.treatments.json"
      }
    ],
    "prune_keep": 3,
    "tag_name": "xi-taric-{year}-rev{number}",
    "commit_message": "chore: NI (XI) TARIC {year} snapshot {number} node index ({effective_date_label})"
  },
  "duty_rates": {
    "source_key": "eu_duties_xlsx",
    "source_format": "taric",
    "geo_areas_key": "eu_geo_xlsx",
    "_comment": "Rates come from the Duties Import workbook staged by the eu_taric acquire step (extras), not the nomenclature CSV."
  }
}
