# R
.Rhistory
.RData
.Rproj.user/

# Local config (user-specific paths — use local_paths.yaml.example as template)
config/local_paths.yaml
config/.chapter99_hash
config/.chapter99_pending

# API credentials (never commit tokens)
.env
scripts/hts_automation/.env.hts_automation

# Data files (large)
data/hts_archives/*.json
data/hts_archives_csv/*.csv
data/processed/
data/timeseries/
data/tpc/*.csv
data/tpc/*.png
data/us_notes/*.pdf
data/cache/
data/cbp/
data/dataweb/
data/spim/

# Output files (all regenerated by pipeline)
output/
snapshots/
changes/
exports/

# Large frontend data exports (>100MB — exceed GitHub file size limit).
# Regenerated by scripts/prepare_frontend_data.R — keep local only.
frontend/public/data/sample_rates.json
frontend/dist/data/sample_rates.json

# Temp/diagnostic scripts
tmpclaude-*
*.tmp
*.log
check_*.R
/test_*.R
/test_*.txt
analyze_*.R
_*.R
*.ps1
*.sh
# Any shell script under scripts/ is a build tool, never scratch — re-include
# the whole subtree so a new entrypoint cannot be silently untracked.
!scripts/**/*.sh
# …but the HTS automation wrapper is a tracked, reviewed script:
!scripts/hts_automation/run_locally.sh
# The `*.sh` rule above is broad; every pipeline entrypoint needs an explicit
# exception or it is silently never committed.
!scripts/hts_automation/refresh_ca.sh

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Internal working files
todo.md
blog*/

# Analysis docs and rendered output (internal working documents)
docs/analysis/*.md
docs/analysis/*.html
docs/analysis/*.pdf

# Additional data directories
data/federal_register/
data/us_notes/*.csv

# Dependencies
node_modules/

# Claude
.claude/
.gstack/

# Python bytecode
**/__pycache__/
*.pyc

# Corpus build artifacts (built into the repo root by run_locally.sh step 4)
# Corpus build artifacts land at the repo root for every jurisdiction.
# Manifests for shipped US revisions are committed deliberately (see below);
# everything else is regenerable from the committed sources.
/us_*.jsonl
/us_*.codes.json
/us_*.manifest.json
/ca_*.jsonl
/ca_*.codes.json
/ca_*.manifest.json
/eu_*.jsonl
/eu_*.codes.json
/eu_*.manifest.json
/do_*.jsonl
/do_*.codes.json
/do_*.manifest.json
/ch_*.jsonl
/ch_*.codes.json
/ch_*.manifest.json
/gb_*.jsonl
/kr_*.jsonl
/kr_*.codes.json
/kr_*.manifest.json
/xi_*.jsonl
/xi_*.codes.json
/xi_*.manifest.json
/gb_*.codes.json
/gb_*.manifest.json
/*_*.coverage.json
/*_*.diff.json
# SPA HTS Explorer datasets (shipped cross-repo by the ship step, not here)
/??_*_revision_*.json
# Derived duty-rate outputs (shipped cross-repo by the ship step)
/*.rates/
/*.rates.index.json
/*.treatments.json

# Vendor payloads pulled from the Avalara cache for validation (not ours to commit)
data/validation/avalara_cache.rds
data/validation/avalara_resolved.rds

# CBSA acquisition cache (zip + accdb + full table exports, tens of MB;
# the canonical sorted TPHS lands beside it as ca_tariff_<rev>.csv)
data/ca_tariff_source/.cbsa_download/
data/eu_tariff_source/.circabc_download/
data/gb_tariff_source/.uk_download/
data/ch_tariff_source/.ch_download/
data/kr_tariff_source/.kr_download/
