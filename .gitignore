# R
.Rhistory
.RData
.Rproj.user/

# Local config (user-specific paths — use local_paths.yaml.example as template)
config/local_paths.yaml
config/.chapter99_hash
config/.chapter99_pending

# API credentials (never commit tokens)
.env
scripts/hts_automation/.env.hts_automation

# Data files (large)
data/hts_archives/*.json
data/hts_archives_csv/*.csv
data/processed/
data/timeseries/
data/tpc/*.csv
data/tpc/*.png
data/us_notes/*.pdf
data/cache/
data/cbp/
data/dataweb/
data/spim/

# Output files (all regenerated by pipeline)
output/
snapshots/
changes/
exports/

# Large frontend data exports (>100MB — exceed GitHub file size limit).
# Regenerated by scripts/prepare_frontend_data.R — keep local only.
frontend/public/data/sample_rates.json
frontend/dist/data/sample_rates.json

# Temp/diagnostic scripts
tmpclaude-*
*.tmp
*.log
check_*.R
/test_*.R
/test_*.txt
analyze_*.R
_*.R
*.ps1
*.sh
# …but the HTS automation wrapper is a tracked, reviewed script:
!scripts/hts_automation/run_locally.sh
# The `*.sh` rule above is broad; every pipeline entrypoint needs an explicit
# exception or it is silently never committed.
!scripts/hts_automation/refresh_ca.sh

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Internal working files
todo.md
blog*/

# Analysis docs and rendered output (internal working documents)
docs/analysis/*.md
docs/analysis/*.html
docs/analysis/*.pdf

# Additional data directories
data/federal_register/
data/us_notes/*.csv

# Dependencies
node_modules/

# Claude
.claude/
.gstack/

# Python bytecode
**/__pycache__/
*.pyc
