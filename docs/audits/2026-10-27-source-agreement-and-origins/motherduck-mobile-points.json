  "sql": "WITH entry_days(entry_day) AS (VALUES (CAST(? AS DATE)),(CAST(? AS DATE)),(CAST(? AS DATE))), origins(country) AS (VALUES (?),(?),(?),(?)) SELECT d.entry_day::VARCHAR entry_day,o.country,r.revision,r.valid_from::VARCHAR valid_from,r.valid_until::VARCHAR valid_until,r.statutory_rate_232,r.statutory_rate_s301fl FROM entry_days d CROSS JOIN origins o LEFT JOIN rates r ON r.hts10=? AND CAST(r.country AS VARCHAR)=o.country AND r.valid_from<=d.entry_day AND r.valid_until>=d.entry_day ORDER BY d.entry_day,o.country,r.revision",
