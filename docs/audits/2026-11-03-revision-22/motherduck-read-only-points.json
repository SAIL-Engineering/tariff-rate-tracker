  "sql": "WITH entries(day,hts10) AS (VALUES (CAST(? AS DATE),?),(CAST(? AS DATE),?),(CAST(? AS DATE),?),(CAST(? AS DATE),?),(CAST(? AS DATE),?),(CAST(? AS DATE),?)),\n   origins(country) AS (VALUES (?),(?),(?))\n   SELECT e.day::VARCHAR entry_day,e.hts10,o.country,r.revision,r.valid_from::VARCHAR valid_from,r.valid_until::VARCHAR valid_until,\n   r.rate_232,r.statutory_rate_232,r.total_rate,r.statutory_total_rate,r.copper_share,r.is_copper_heading FROM entries e CROSS JOIN origins o LEFT JOIN rates r\n   ON r.hts10=e.hts10 AND CAST(r.country AS VARCHAR)=o.country AND r.valid_from<=e.day AND r.valid_until>=e.day\n   ORDER BY e.day,e.hts10,o.country,r.revision",
