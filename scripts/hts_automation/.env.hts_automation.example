# =============================================================================
# .env.hts_automation.example
# =============================================================================
# Copy this file to `.env.hts_automation` in the same directory, fill in the
# real values, and `run_locally.sh` will source it automatically.
#
#   cp scripts/hts_automation/.env.hts_automation.example \
#      scripts/hts_automation/.env.hts_automation
#
# The real .env.hts_automation file is gitignored — never commit it.
# =============================================================================

# ─── Ragie ────────────────────────────────────────────────────────────
RAGIE_API_KEY=tnt_REPLACE_ME

# ─── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=https://ffrphrvbtucjbdszexxa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJREPLACE_ME

# ─── Railway ──────────────────────────────────────────────────────────
# Project-scoped API token (preferred) or team token.
RAILWAY_TOKEN=REPLACE_ME
RAILWAY_PROJECT_ID=REPLACE_ME
RAILWAY_SERVICE_ID=REPLACE_ME
RAILWAY_ENVIRONMENT_ID=REPLACE_ME

# ─── Vercel ───────────────────────────────────────────────────────────
VERCEL_TOKEN=REPLACE_ME
VERCEL_PROJECT_ID=prj_REPLACE_ME
# Only set if the project is on a Vercel team:
# VERCEL_TEAM_ID=team_REPLACE_ME

# ─── sail-gtx-prerelease cross-repo push ──────────────────────────────
# Fine-grained PAT with contents:write on SAIL-Engineering/sail-gtx-prerelease.
SAIL_GTX_REPO_PAT=github_pat_REPLACE_ME

# Production branch the JSON commit + Railway/Vercel deploys read from.
# Update this whenever the production branch changes — single source of truth.
SAIL_GTX_PRODUCTION_BRANCH=illegal-transshipment

# Public URLs the smoke test hits after the redeploy lands.
SAIL_GTX_HEALTHCHECK_URL=https://sail-gtx-prerelease-production.up.railway.app/health
SAIL_GTX_API_BASE=https://sail-gtx-prerelease-production.up.railway.app

# Optional: only required if you flip skip_smoke_classify off and the
# /api/classify route requires auth.
# SAIL_GTX_API_AUTH_TOKEN=REPLACE_ME

# Optional commit identity for the cross-repo push.
GIT_USER_NAME=sail-gtx-bot
GIT_USER_EMAIL=sail-gtx-bot@users.noreply.github.com
