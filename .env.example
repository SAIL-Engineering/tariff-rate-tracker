# =============================================================================
# API / Backend config
# =============================================================================

# Which database the Express API reads from.
#   local      = in-memory DuckDB + read_parquet() over data/timeseries/rate_timeseries_parquet
#   motherduck = cloud MotherDuck DB (requires MOTHERDUCK_TOKEN)
DATABASE_TARGET=local

# MotherDuck credentials. Required when DATABASE_TARGET=motherduck and when
# running `npm run db:push-to-cloud`. Get a token from https://app.motherduck.com.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=duty_calculator

# Express server port (Railway injects PORT automatically; API_PORT is for local dev).
API_PORT=3001

# Comma-separated CORS allowlist. Use wildcards for Vercel preview URLs.
# Leave empty in local dev to allow all origins.
# Example for deploy:
#   CORS_ALLOWED_ORIGINS=https://sail-gtx.vercel.app,https://sail-gtx-prerelease-*.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# =============================================================================
# R pipeline config (unrelated to the API)
# =============================================================================

# USITC DataWeb API token
# Register at https://dataweb.usitc.gov/ to obtain your own token.
# Only needed for src/download_usmca_dataweb.R (trade weight downloads).
# The core pipeline does NOT require this token.
DATAWEB_API_TOKEN=<your-token-here>
